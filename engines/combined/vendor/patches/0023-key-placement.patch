+  const movable = [...movableSources.keys()].sort();
+  diagnostics.movableKeys = movable;
+  if (movable.length === 0) throw new KeyPlacementError("KEY_PLACEMENT_NOTHING_TO_PLACE", "No key of the catalog can be moved.", diagnostics);
