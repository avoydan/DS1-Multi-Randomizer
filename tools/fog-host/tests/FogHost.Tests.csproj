<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Self-test console for FogHost (no test-framework dependency).
    Run: dotnet run -c Release (after building ../FogHost.csproj in Release).
    Tests that need FogMod data run only when DS1TR_FOG_DATA_ROOT points at a verified data root.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS0612;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FogHost.csproj" />
  </ItemGroup>
</Project>
