<Project Sdk="Microsoft.NET.Sdk">
  <!-- Development-only parser, semantic comparer, and recipe extractor. Not included in application packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>FogReconstruction</AssemblyName>
    <RootNamespace>FogReconstruction</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\fog-host\FogHost.csproj" />
  </ItemGroup>
</Project>
