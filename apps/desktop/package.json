{
  "name": "@ds1tr/desktop",
  "version": "0.35.1",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build --configLoader runner && tsc -p electron/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "node --test electron/settings.test.mjs electron/language.test.mjs electron/saveFile.test.mjs src/i18n/locales.test.mjs electron/launchGame.test.mjs electron/channel.test.mjs src/ui/settingsCoverage.test.mjs ../../tools/release/release-tools.test.mjs",
    "package:win": "node scripts/package-win.mjs"
  },
  "dependencies": {
    "@ds1tr/contracts": "*",
    "i18next": "^26.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "34.5.8",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
