    "start": "node dist/server.js"
  },
  "dependencies": {
    "@ds1tr/contracts": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
